set nocompatible
set runtimepath-=~/.vim
set viminfo=
set noswapfile
set termguicolors
set t_RV= t_u7= t_SH= t_RS=
filetype plugin indent on
syntax on
set background=dark
colorscheme habamax
" cinema mode (D11)
let loaded_matchparen = 1
set number signcolumn=no laststatus=0 noshowmode noruler noshowcmd
set shortmess+=IFWs cursorline nowrap nolist
set fillchars=eob:\ 
set cmdheight=1 timeoutlen=300 ttimeoutlen=10
hi Normal guifg=#d7d7d7 guibg=#1c1c1c
hi EndOfBuffer guifg=#1c1c1c guibg=NONE
hi LineNr guifg=#a0a0a0 guibg=NONE
hi CursorLine guibg=#2a2a2a
hi CursorLineNr guifg=#eeeeee gui=bold
" token hues (V1): keyword pink, name cyan, string yellow, number orange,
" type purple, comment green; punctuation grey. Contrast measured in README.
hi Keyword guifg=#ff79c6 gui=NONE
hi Statement guifg=#ff79c6 gui=NONE
hi PreProc guifg=#ff79c6 gui=NONE
hi Label guifg=#ff79c6 gui=NONE
hi Function guifg=#8be9fd gui=NONE
hi Identifier guifg=#8be9fd gui=NONE
hi String guifg=#f1fa8c gui=NONE
hi Character guifg=#f1fa8c gui=NONE
hi Number guifg=#ffb86c gui=NONE
hi Constant guifg=#ffb86c gui=NONE
hi Type guifg=#bd93f9 gui=NONE
hi Special guifg=#bd93f9 gui=NONE
hi Comment guifg=#8fd18f gui=NONE
hi Delimiter guifg=#c7c7c7 gui=NONE
hi Operator guifg=#c7c7c7 gui=NONE

" V1: the active line keeps full syntax colors; every other line keeps its
" hues, each blended 55% toward the background (text properties, per token).
let g:bg = [0x1c, 0x1c, 0x1c]
function! s:Fade(hex) abort
  let c = [str2nr(a:hex[1:2], 16), str2nr(a:hex[3:4], 16), str2nr(a:hex[5:6], 16)]
  let o = '#'
  for i in range(3)
    let o .= printf('%02x', float2nr(c[i] * 0.78 + g:bg[i] * 0.22))
  endfor
  return o
endfunction
function! s:Type(id) abort
  let n = 'DemoFd' . a:id
  if empty(prop_type_get(n))
    let fg = synIDattr(a:id, 'fg#')
    if empty(fg) | let fg = '#d7d7d7' | endif
    execute 'hi ' . n . ' guifg=' . s:Fade(fg)
    call prop_type_add(n, {'highlight': n})
  endif
  return n
endfunction
function! DemoTick(l) abort
  call prop_clear(1, line('$'))
  for ln in range(1, line('$'))
    if ln == a:l | continue | endif
    let t = getline(ln)
    let c = 1
    while c <= len(t)
      let id = synIDtrans(synID(ln, c, 1))
      let e = c
      while e < len(t) && synIDtrans(synID(ln, e + 1, 1)) == id
        let e += 1
      endwhile
      call prop_add(ln, c, {'length': e - c + 1, 'type': s:Type(id)})
      let c = e + 1
    endwhile
  endfor
  execute a:l
  redraw
endfunction
function! DemoClear() abort
  setlocal nocursorline
  call prop_clear(1, line('$'))
  redraw
endfunction
nnoremap <silent> ,1 :call DemoTick(get(g:, "ticks", [6,10,11,12])[1-1])<CR>
nnoremap <silent> ,2 :call DemoTick(get(g:, "ticks", [6,10,11,12])[2-1])<CR>
nnoremap <silent> ,3 :call DemoTick(get(g:, "ticks", [6,10,11,12])[3-1])<CR>
nnoremap <silent> ,4 :call DemoTick(get(g:, "ticks", [6,10,11,12])[4-1])<CR>
nnoremap <silent> ,0 :call DemoClear()<CR>
