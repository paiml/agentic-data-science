bat -p lean/AgenticDS/AgenticDS/Scenes/M3V05.lean
echo "exit=$? #01"
(cd lean/AgenticDS && lake env lean AgenticDS/Scenes/M3V05.lean)
echo "exit=$? #02"
make lean-scan
echo "exit=$? #03"
printf 'theorem planted : 2 + 2 = 4 := by native_decide
' > lean/AgenticDS/AgenticDS/Scratch.lean
echo "exit=$? #04"
cat lean/AgenticDS/AgenticDS/Scratch.lean
