@prefix ads: <https://paiml.com/ns/ads#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://paiml.com/ns/ads#c-m1-p1> a ads:Example ;
  ads:language "r" ;
  ads:course "C" ;
  ads:module "1"^^xsd:integer ;
  ads:problem "P1" ;
  ads:dataset ads:penguins ;
  ads:readme "r/agenticds/inst/examples/c-m1-p1/README.md" ;
  ads:lineCoverage "100.0"^^xsd:decimal ;
  ads:lintWarnings "0"^^xsd:integer ;
  ads:ticket "#1" ;
  ads:contract "contracts/ads-r-p1-v1.yaml" ;
  ads:parityGolden "datasets/golden/p1.json" ;
  ads:branchCasesEnumerated true .
