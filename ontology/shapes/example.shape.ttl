@prefix ads: <https://paiml.com/ns/ads#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ads:ExampleShape a sh:NodeShape ;
  sh:targetClass ads:Example ;
  sh:property [ sh:path ads:language ; sh:in ("rust" "julia" "r" "kotlin" "lean") ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ads:course ; sh:in ("A" "B" "C" "D" "E") ; sh:minCount 1 ] ;
  sh:property [ sh:path ads:module ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 4 ] ;
  sh:property [ sh:path ads:problem ; sh:in ("P1" "P2" "P3" "P4") ; sh:minCount 1 ] ;
  sh:property [ sh:path ads:dataset ; sh:class ads:Dataset ; sh:minCount 1 ] ;
  sh:property [ sh:path ads:readme ; sh:datatype xsd:string ; sh:pattern "README\\.md$" ; sh:minCount 1 ] ;
  sh:property [ sh:path ads:lintWarnings ; sh:datatype xsd:integer ; sh:maxInclusive 0 ] ;
  sh:or (
    [ sh:property [ sh:path ads:lineCoverage ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:minInclusive 100.0 ] ;
      sh:property [ sh:path ads:language ; sh:in ("rust" "julia" "r" "kotlin") ] ]
    [ sh:property [ sh:path ads:language ; sh:hasValue "lean" ] ;
      sh:property [ sh:path ads:sorryCount ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxInclusive 0 ] ;
      sh:property [ sh:path ads:axiomsClean ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:hasValue true ] ]
  ) ;
  sh:property [ sh:path ads:ticket ; sh:pattern "^#[0-9]+$" ; sh:minCount 1 ] ;
  sh:property [ sh:path ads:contract ; sh:minCount 1 ] ;
  sh:property [ sh:path ads:parityGolden ; sh:minCount 1 ] .
