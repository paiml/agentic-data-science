@prefix ads: <https://paiml.com/ns/ads#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ads:ArtifactShape a sh:NodeShape ;
  sh:targetClass ads:Artifact ;
  sh:property [ sh:path ads:schemaVersion ; sh:datatype xsd:string ; sh:minCount 1 ] ;
  sh:property [ sh:path ads:generatedBy ; sh:minCount 1 ] .
