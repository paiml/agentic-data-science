# Shared terminal-recording geometry for every course (14x34 for ALL courses at 1080p).
# Font px = round(CELL_W / 0.6); termctrl scales the glyph with the cell height, so the pair is fixed together: 14x34 -> ~24 px font,
# advance/ink ratio ~1.17 (the old 20x28 gave 2.14: letter-spaced text). Code line height 34 px >= 28 (T3). Never scale the recording.
CELL_W=14
CELL_H=34
COLS=137            # 137 x 14 = 1918 px (1 px pad each side)
ROWS=31             # 31 x 34 = 1054 px (13 px pad top and bottom)
CODE_COLS=85        # code + terminal column before the plot pane: 85 x 14 = 1190 px (62%)
PLOT_X=1200         # the native 720x1080 plot is overlaid here, never scaled
PLOT_W=720
PLOT_H=1080
