" vimrc.demo: cinema mode (D11). Pinned in the image; palette hex below is what README measures.
set nocompatible
set encoding=utf-8
set termguicolors
set t_Co=256
set runtimepath^=/pl/julia-vim
let g:latex_to_unicode_auto = 0
let g:latex_to_unicode_tab = 0
filetype plugin indent on
syntax on
set number
set signcolumn=no
set laststatus=0
set noshowmode
set noruler
set noshowcmd
set cmdheight=1
set nowrap
set cursorline
set nocursorcolumn
set shortmess=aoOtTIcF
set fillchars=eob:\ 
set scrolloff=0
set nolist
set belloff=all
set background=dark
hi clear
let g:colors_name = 'demo'
hi Normal       guifg=#d8dcef guibg=#1b1d2b
hi NonText      guifg=#1b1d2b guibg=#1b1d2b
hi EndOfBuffer  guifg=#1b1d2b guibg=#1b1d2b
hi LineNr       guifg=#aab0cf guibg=#1b1d2b
hi CursorLineNr guifg=#ffffff guibg=#2a2e45 gui=bold
hi CursorLine   guibg=#242840 gui=NONE
hi Comment      guifg=#b8bfdf gui=italic
hi Delimiter    guifg=#c4cae6
hi Operator     guifg=#c4cae6
hi Keyword      guifg=#ff9ac1
hi Statement    guifg=#ff9ac1
hi Conditional  guifg=#ff9ac1
hi Repeat       guifg=#ff9ac1
hi Include      guifg=#ff9ac1
hi Function     guifg=#7fd0ff
hi Identifier   guifg=#d8dcef
hi Constant     guifg=#ffc777
hi Number       guifg=#ffc777
hi Float        guifg=#ffc777
hi String       guifg=#9fe6a0
hi Character    guifg=#9fe6a0
hi Type         guifg=#c3a6ff
hi Special      guifg=#7fd0ff
hi SpecialChar  guifg=#ffc777
hi Todo         guifg=#ffc777 gui=bold
hi PreProc       guifg=#ffae7f
hi link juliaSymbol Type
hi link juliaSymbolS Type
" V1 spotlight: the active line keeps full syntax colors; every other line
" keeps its hues, alpha-blended FADE of the way toward the background.
let s:bg = [0x1b, 0x1d, 0x2b]
let s:fade = 0.55
let s:active_bg = '#33395c'
function! s:Hex(c) abort
  return [str2nr(a:c[1:2], 16), str2nr(a:c[3:4], 16), str2nr(a:c[5:6], 16)]
endfunction
function! s:Blend(fg) abort
  let l:rgb = s:Hex(a:fg)
  let l:o = []
  for l:i in range(3)
    call add(l:o, float2nr(round(l:rgb[l:i] * (1 - s:fade) + s:bg[l:i] * s:fade)))
  endfor
  return printf('#%02x%02x%02x', l:o[0], l:o[1], l:o[2])
endfunction
function! s:FadedGroup(id) abort
  let l:fg = synIDattr(a:id, 'fg#', 'gui')
  if l:fg !~ '^#'
    let l:fg = '#d8dcef'
  endif
  let l:name = 'Fade_' . l:fg[1:]
  let l:it = synIDattr(a:id, 'italic', 'gui') ? 'italic' : 'NONE'
  execute 'hi ' . l:name . ' guifg=' . s:Blend(l:fg) . ' guibg=#1b1d2b gui=' . l:it
  return l:name
endfunction
function! s:FadeLine(n) abort
  let l:text = getline(a:n)
  let l:len = strlen(l:text)
  let l:start = 1
  while l:start <= l:len
    let l:id = synIDtrans(synID(a:n, l:start, 1))
    let l:end = l:start
    while l:end < l:len && synIDtrans(synID(a:n, l:end + 1, 1)) == l:id
      let l:end += 1
    endwhile
    call matchaddpos(s:FadedGroup(l:id), [[a:n, l:start, l:end - l:start + 1]], 100)
    let l:start = l:end + 1
  endwhile
endfunction
function! Tick(n) abort
  call clearmatches()
  execute 'hi CursorLine guibg=' . s:active_bg
  for l:i in range(1, line('$'))
    if l:i != a:n
      call s:FadeLine(l:i)
    endif
  endfor
  call cursor(a:n, 1)
  redraw
endfunction
function! TickOff() abort
  call clearmatches()
  hi CursorLine guibg=#242840
  redraw
endfunction
nnoremap <silent> <F2> <Cmd>call Tick(1)<CR>
nnoremap <silent> <F3> <Cmd>call Tick(3)<CR>
nnoremap <silent> <F4> <Cmd>call Tick(7)<CR>
nnoremap <silent> <F5> <Cmd>call Tick(8)<CR>
nnoremap <silent> <F6> <Cmd>call Tick(17)<CR>
nnoremap <silent> <F10> <Cmd>call TickOff()<CR>
