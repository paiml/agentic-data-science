file = src/main/kotlin/com/paiml/ads/Kmeans.kt
lines = 80-93
ticks = 1-4,5-11,12-14
run = ./gradlew --console=plain ktlintCheck
cwd = kotlin
ready = BUILD SUCCESSFUL
plot = none
tool = ktlint
open_rule = no plot in the 3 s hold, full-width scene (tool-scene-rule)
after = echo "exit=$?"
exit = exit=0
note = ktlint max line width 68 over the main sources
