file = examples/d-m3-p3/example.ttl
lines = 1-19
ticks = 1-1,2-3,4-17,18-19
run = ./gradlew --console=plain verifyShaclP3
cwd = kotlin
ready = BUILD SUCCESSFUL
plot = none
tool = shacl
open_rule = no plot in the 3 s hold, full-width scene (tool-scene-rule: the wired gate task, full-width, no plot)
after = echo "exit=$?"
exit = exit=0
note = one wired gate task, CI runs it: scripts/gate-kotlin.sh verifyShaclAll via make gate-kotlin, ci.yml line 64 (no pipe, grep, alias or wrapper on the line); Jena exits 0 on a finding, so the task fails unless the report says sh:conforms true, echoes that Jena line, then a separate exit=0. Negative control (not on camera): ToolsCanFailTest runs the task on a broken file and expects non-zero
